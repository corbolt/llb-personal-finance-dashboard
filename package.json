{
  "name": "llb-rocket",
  "version": "0.1.0",
  "private": true,
  "description": "Personal finance tracker for bank exports: spending, recurring payments and budgets, stored in a local SQLite file.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
