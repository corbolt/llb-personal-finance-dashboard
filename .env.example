# Copy to .env and adjust. start.sh reads this file; Next.js reads it too.
# There is no login: whoever can reach the address can read and change everything.

# Address the server listens on. 127.0.0.1 = this machine only.
# To reach the app from other devices, use the machine's address in the
# network (or 0.0.0.0 for all of its addresses).
HOST=127.0.0.1

# Port, 3000 if not set.
# PORT=3000

# Host names other than localhost that requests may be addressed to —
# needed as soon as HOST is not 127.0.0.1. Comma separated.
# ALLOWED_HOSTS=192.168.178.3

# Where the database lives, data/finance.db if not set.
# DATABASE_PATH=/path/to/finance.db
